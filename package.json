{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' tsx server.ts",
    "build": "NODE_OPTIONS='--max-old-space-size=4096' node scripts/generate-version.cjs && NODE_OPTIONS='--max-old-space-size=4096' vite build && node scripts/generate-version.cjs --sync-dist && node -e \"const fs = require('fs'); const path = require('path'); const nested = path.join('dist', 'app', 'applet', 'index.html'); if (fs.existsSync(nested)) { fs.copyFileSync(nested, path.join('dist', 'index.html')); }\" && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node --max-old-space-size=4096 dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "NODE_OPTIONS='--max-old-space-size=4096' tsc --noEmit",
    "validate:schema": "tsx scripts/validate_schema_and_integrity.ts --schema-only",
    "validate:integrity": "tsx scripts/validate_schema_and_integrity.ts",
    "retrieve:supabase": "tsx scripts/retrieve_supabase_snapshot.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/compression": "^1.8.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.0",
    "@types/pdfmake": "^0.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "d3": "^7.9.2",
    "docx-preview": "^0.4.1",
    "dotenv": "^17.2.3",
    "emoji-picker-react": "^5.1.4",
    "express": "^4.21.2",
    "html-docx-js-typescript": "^0.1.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jsonrepair": "^3.15.0",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "mammoth": "^1.13.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.14",
    "q": "^2.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0",
    "wacomgss-npm": "^0.5.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
